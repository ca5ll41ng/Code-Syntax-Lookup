{
  "name": "code-syntax-lookup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "白盒审计用多语言语法与安全知识库（人可搜索，AI 可读取）",
  "license": "MIT",
  "scripts": {
    "adapter:php": "node sources/php_adapter.mjs",
    "adapter:python": "node sources/python_adapter.mjs",
    "adapter:java": "node sources/java_adapter.mjs",
    "adapter:owasp": "node sources/owasp_adapter.mjs",
    "enrich": "node pipeline/enrich.mjs",
    "index": "node pipeline/index.mjs",
    "embed": "node pipeline/embed.mjs",
    "llmstxt": "node pipeline/llmstxt.mjs",
    "site:build": "node pipeline/build_site.mjs && cd docs-site && npx pagefind --site dist",
    "site:preview": "cd docs-site && npx pagefind --site dist --serve",
    "build": "npm run adapter:php && npm run adapter:python && npm run adapter:java && npm run adapter:owasp && npm run enrich && npm run index && npm run embed && npm run llmstxt && npm run site:build",
    "test": "node test/mcp_smoke.mjs",
    "mcp": "node server/mcp_server.mjs",
    "ask": "node server/ask.mjs",
    "update": "node pipeline/update.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "fast-xml-parser": "^5.11.2",
    "markdown-it": "^15.0.2"
  }
}
